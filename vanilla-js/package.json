{
  "name": "ai-avatar-bot-vanilla-js",
  "version": "1.0.0",
  "description": "Interactive 2D (Live2D) and 3D (VRM) AI Avatar Bot with Voice STT/TTS, In-Browser WebGPU WebLLM, Cloud AI Brain, Conversation Memory, and Function Calling",
  "type": "module",
  "main": "./dist/ai-avatar-bot.cjs",
  "module": "./dist/ai-avatar-bot.js",
  "types": "./types/index.d.ts",
  "bin": {
    "ai-avatar-bot": "./bin/cli.js"
  },
  "files": [
    "dist",
    "avatar-skin",
    "plugins",
    "bin",
    "types"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/ai-avatar-bot.js",
      "require": "./dist/ai-avatar-bot.cjs"
    },
    "./brain": {
      "types": "./types/index.d.ts",
      "import": "./dist/brain.js",
      "require": "./dist/brain.cjs"
    },
    "./skin": {
      "types": "./types/index.d.ts",
      "import": "./dist/skin.js",
      "require": "./dist/skin.cjs"
    },
    "./speech": {
      "types": "./types/index.d.ts",
      "import": "./dist/speech.js",
      "require": "./dist/speech.cjs"
    },
    "./tools": {
      "types": "./types/index.d.ts",
      "import": "./dist/tools.js",
      "require": "./dist/tools.cjs"
    },
    "./i18n": {
      "types": "./types/index.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./plugins": {
      "types": "./types/index.d.ts",
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.cjs"
    },
    "./constants": {
      "types": "./types/index.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*",
    "./avatar-skin/*": "./avatar-skin/*",
    "./package.json": "./package.json",
    "./vite": {
      "import": "./plugins/vite.js",
      "require": "./plugins/vite.cjs"
    },
    "./webpack": {
      "import": "./plugins/webpack.js",
      "require": "./plugins/webpack.cjs"
    },
    "./next": {
      "import": "./plugins/next.js",
      "require": "./plugins/next.cjs"
    },
    "./nuxt": {
      "import": "./plugins/nuxt.js",
      "require": "./plugins/nuxt.cjs"
    },
    "./analog": {
      "import": "./plugins/analog.js",
      "require": "./plugins/analog.cjs"
    },
    "./nitro": {
      "import": "./plugins/nitro.js",
      "require": "./plugins/nitro.cjs"
    },
    "./node": {
      "import": "./plugins/node.js",
      "require": "./plugins/node.cjs"
    }
  },
  "keywords": [
    "avatar",
    "ai",
    "live2d",
    "vrm",
    "threejs",
    "webllm",
    "webgpu",
    "speech-recognition",
    "tts",
    "stt",
    "chatbot",
    "virtual-human",
    "3d-avatar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archer102125220/ai-avatar-bot.git",
    "directory": "package/vanilla-js"
  },
  "bugs": {
    "url": "https://github.com/archer102125220/ai-avatar-bot/issues"
  },
  "homepage": "https://github.com/archer102125220/ai-avatar-bot#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:report": "vitest run --reporter=html",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:contract": "playwright test --project=contract",
    "test:e2e:engine": "playwright test --project=engine",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "vite": "^8.1.1",
    "vitest": "^5.0.0"
  }
}
