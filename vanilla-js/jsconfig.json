{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "core/**/*",
    "test/**/*",
    "example/**/*",
    "plugins/**/*",
    "bin/**/*",
    "index.d.ts",
    "index.html"
  ]
}

