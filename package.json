{
  "name": "ai-avatar-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Web 右下角 Live2D 語音 AI 虛擬人 demo",
  "scripts": {
    "dev:iframe": "npm run dev -w iframe",
    "dev:ts": "yarn workspace ai-avatar-bot-typescript dev",
    "dev:vue": "yarn workspace ai-avatar-bot-vue dev",
    "dev:react": "yarn workspace ai-avatar-bot-react dev",
    "build:ts": "yarn workspace ai-avatar-bot-typescript build",
    "build:vue": "yarn workspace ai-avatar-bot-vue build",
    "build:react": "yarn workspace ai-avatar-bot-react build",
    "build": "npm run build --workspaces --if-present",
    "test:ts": "yarn workspace ai-avatar-bot-typescript test:unit",
    "test:ts:benchmark": "yarn workspace ai-avatar-bot-typescript test:benchmark",
    "test:ts:watch": "yarn workspace ai-avatar-bot-typescript test:unit:watch",
    "test:ts:ui": "yarn workspace ai-avatar-bot-typescript test:unit:ui",
    "test:ts:report": "yarn workspace ai-avatar-bot-typescript test:unit:report",
    "test:ts:coverage": "yarn workspace ai-avatar-bot-typescript test:unit:coverage",
    "test:ts:e2e": "yarn workspace ai-avatar-bot-typescript test:e2e",
    "test:ts:e2e:contract": "yarn workspace ai-avatar-bot-typescript test:e2e:contract",
    "test:ts:e2e:engine": "yarn workspace ai-avatar-bot-typescript test:e2e:engine",
    "test:ts:smoke": "yarn workspace ai-avatar-bot-typescript test:smoke",
    "typecheck:ts": "yarn workspace ai-avatar-bot-typescript test:typecheck",
    "lint:ts": "yarn workspace ai-avatar-bot-typescript lint",
    "build:examples": "node scripts/build-examples.mjs all",
    "build:examples:vanilla-ts": "node scripts/build-examples.mjs vanilla-ts",
    "build:examples:vanilla-js": "node scripts/build-examples.mjs vanilla-js",
    "build:examples:react": "node scripts/build-examples.mjs react",
    "build:examples:vue": "node scripts/build-examples.mjs vue",
    "build:examples:next": "node scripts/build-examples.mjs next",
    "build:examples:nuxt": "node scripts/build-examples.mjs nuxt",
    "build:examples:angular": "node scripts/build-examples.mjs angular",
    "build:examples:analog": "node scripts/build-examples.mjs analog",
    "example:dev": "node scripts/run-example.mjs dev",
    "example:preview": "node scripts/run-example.mjs preview",
    "dev:example:ts": "node scripts/run-example.mjs dev ts",
    "dev:example:js": "node scripts/run-example.mjs dev js",
    "dev:example:react": "node scripts/run-example.mjs dev react",
    "dev:example:vue": "node scripts/run-example.mjs dev vue",
    "dev:example:next": "node scripts/run-example.mjs dev next",
    "dev:example:nuxt": "node scripts/run-example.mjs dev nuxt",
    "dev:example:angular": "node scripts/run-example.mjs dev angular",
    "dev:example:analog": "node scripts/run-example.mjs dev analog",
    "preview:example:ts": "node scripts/run-example.mjs preview ts",
    "preview:example:js": "node scripts/run-example.mjs preview js",
    "preview:example:react": "node scripts/run-example.mjs preview react",
    "preview:example:vue": "node scripts/run-example.mjs preview vue",
    "preview:example:next": "node scripts/run-example.mjs preview next",
    "preview:example:nuxt": "node scripts/run-example.mjs preview nuxt",
    "preview:example:angular": "node scripts/run-example.mjs preview angular",
    "preview:example:analog": "node scripts/run-example.mjs preview analog",
    "test:smoke:assets": "node scripts/smoke-test-assets.mjs",
    "test:matrix": "node scripts/verify-matrix.mjs ts",
    "test:matrix:ts": "node scripts/verify-matrix.mjs ts",
    "test:matrix:react": "node scripts/verify-matrix.mjs react",
    "test:matrix:vue": "node scripts/verify-matrix.mjs vue",
    "test:matrix:all": "node scripts/verify-matrix.mjs all",
    "test": "npm run test:unit --workspaces --if-present"
  },
  "workspaces": [
    "typescript",
    "vue",
    "react",
    "iframe"
  ],
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "msedge-tts": "^2.0.6"
  }
}
