{
  "name": "ai-avatar-bot-typescript",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/ai-avatar-bot.umd.cjs",
  "module": "./dist/ai-avatar-bot.js",
  "types": "./dist/core/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/main.d.ts",
      "import": "./dist/ai-avatar-bot.js",
      "require": "./dist/ai-avatar-bot.umd.cjs"
    },
    "./style.css": "./dist/ai-avatar-bot.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:report": "vitest run --reporter=html",
    "test:unit:coverage": "vitest run --coverage",
    "test:benchmark": "vitest run test/unit",
    "test:typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test:e2e": "PLAYWRIGHT_HTML_REPORT_DIR=playwright-report/all playwright test",
    "test:e2e:contract": "PLAYWRIGHT_HTML_REPORT_DIR=playwright-report/contract playwright test --project=contract",
    "test:e2e:engine": "PLAYWRIGHT_HTML_REPORT_DIR=playwright-report/engine playwright test --project=engine",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report/all",
    "test:e2e:report:contract": "playwright show-report playwright-report/contract",
    "test:e2e:report:engine": "playwright show-report playwright-report/engine",
    "test:smoke": "yarn build && PLAYWRIGHT_HTML_REPORT_DIR=playwright-report/smoke playwright test test/e2e/specs/engine/dist-smoke.spec.ts",
    "test:e2e:report:smoke": "playwright show-report playwright-report/smoke",
    "lint": "eslint core/",
    "lint:fix": "eslint core/ --fix"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.0"
  }
}
