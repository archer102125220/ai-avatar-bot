{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Linting */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "paths": {
      "@/*": ["./*"],
      "@core/*": ["./core/*"],
      "@test/*": ["./test/*"],
      "@style/*": ["./style/*"],
      "@types/*": ["./types/*"]
    }
  },
  "include": [
    "core/**/*",
    "test/**/*",
    "types/**/*",
    "*.config.ts",
    "*.d.ts"
  ]
}